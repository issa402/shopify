#!/usr/bin/env bash
# Blocks large staged files and refreshes code-review-graph context before commit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Keep accidental large files out of Git history.
scripts/check-large-files.sh --staged

# Keep the local review graph fresh. Do not block commits if graph tooling fails.
if command -v code-review-graph >/dev/null 2>&1; then
    code-review-graph update || true
    code-review-graph detect-changes --brief || true
fi
